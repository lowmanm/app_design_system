{
  "name": "playground-bootstrap",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/playground-bootstrap/src",
  "tags": ["scope:playground"],
  "implicitDependencies": ["tokens", "bootstrap-overrides"],
  "targets": {
    "generate-styles": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap-overrides:build"],
      "options": {
        "commands": [
          "sass --load-path=../../node_modules --no-source-map src/styles.entry.scss src/generated/styles.css",
          "mkdir -p src/generated/css && cp ../../node_modules/@app-design-system/tokens/dist/css/fonts.css src/generated/css/ && cp -r ../../node_modules/@app-design-system/tokens/dist/fonts src/generated/"
        ],
        "parallel": false,
        "cwd": "apps/playground-bootstrap"
      },
      "outputs": ["{projectRoot}/src/generated"],
      "cache": true,
      "inputs": ["{projectRoot}/src/styles.entry.scss", "^production"]
    },
    "build": {
      "dependsOn": ["generate-styles"]
    },
    "serve": {
      "dependsOn": ["generate-styles"]
    }
  }
}
