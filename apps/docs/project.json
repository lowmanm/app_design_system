{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/docs/src",
  "tags": ["scope:docs"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/docs",
        "browser": "apps/docs/src/main.ts",
        "tsConfig": "apps/docs/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/docs/public"
          }
        ],
        "styles": ["apps/docs/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["node_modules"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "docs:build:production"
        },
        "development": {
          "buildTarget": "docs:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "generate-brand-css": {
      "executor": "nx:run-commands",
      "dependsOn": ["tokens:build"],
      "options": {
        "command": "node scripts/generate-brand-css.mjs",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/src/generated"],
      "cache": true,
      "inputs": ["{projectRoot}/scripts/generate-brand-css.mjs", "^production"]
    },
    "storybook-browser-target": {
      "executor": "@angular-devkit/build-angular:browser",
      "options": {
        "outputPath": "dist/apps/docs-storybook-browser-target",
        "index": "apps/docs/src/index.html",
        "main": "apps/docs/src/main.ts",
        "tsConfig": "apps/docs/tsconfig.storybook-browser-target.json",
        "polyfills": ["zone.js"],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/docs/public"
          }
        ],
        "styles": [
          "node_modules/@app-design-system/tokens/dist/css/fonts.css",
          "node_modules/@app-design-system/tokens/dist/css/core.css",
          "node_modules/@app-design-system/tokens/dist/css/typography.css",
          "apps/docs/src/generated/brand-themes.css",
          "apps/docs/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["node_modules"]
        }
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "dependsOn": ["generate-brand-css", "generate-appearance-data"],
      "options": {
        "browserTarget": "docs:storybook-browser-target",
        "configDir": "apps/docs/.storybook",
        "port": 4400,
        "compodoc": false,
        "docs": true
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "dependsOn": ["generate-brand-css", "generate-appearance-data"],
      "outputs": ["{options.outputDir}"],
      "options": {
        "browserTarget": "docs:storybook-browser-target",
        "configDir": "apps/docs/.storybook",
        "outputDir": "apps/docs/storybook-static",
        "compodoc": false,
        "docs": true
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "docs:build",
        "staticFilePath": "dist/apps/docs/browser",
        "spa": true
      }
    },
    "generate-appearance-data": {
      "executor": "nx:run-commands",
      "dependsOn": ["tokens:build"],
      "options": {
        "command": "node scripts/generate-appearance-data.mjs",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/.storybook/appearance-data.json"],
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-appearance-data.mjs",
        "^production"
      ]
    }
  }
}
