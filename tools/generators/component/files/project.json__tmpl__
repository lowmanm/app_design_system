{
  "name": "<%= name %>",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/components/<%= name %>/src",
  "prefix": "brk",
  "projectType": "library",
  "tags": ["scope:angular"],
  "implicitDependencies": ["core"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["core:build"],
      "outputs": ["{workspaceRoot}/dist/packages/components/<%= name %>"],
      "options": {
        "command": "ng-packagr -p ng-package.json -c tsconfig.package.json",
        "cwd": "packages/components/<%= name %>"
      }
    }
  }
}
