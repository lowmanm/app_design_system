# Add files here to ignore them from prettier formatting

# Build output. These globs are intentionally unanchored - `/dist` alone
# would only match the root one, leaving packages/*/dist (Style Dictionary
# output, compiled themes) to be reformatted by `nx format:write`.
dist
storybook-static
coverage
tmp
out-tsc

# Generated sources, regenerated by `nx run <project>:build`/`:generate-*`
packages/theme-angular-material/generated
apps/playground-bootstrap/src/generated
apps/docs/src/generated

# Palette JSON is emitted by packages/tokens/scripts/generate-palettes.mjs;
# reformatting it would produce a permanent diff against the generator.
packages/tokens/src/reference/brands

.angular
.nx/cache
.nx/workspace-data
.nx/self-healing
pnpm-lock.yaml
