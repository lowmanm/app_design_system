{
  "name": "tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tokens/src",
  "projectType": "library",
  "tags": ["scope:tokens"],
  "targets": {
    "generate-palettes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/generate-palettes.mjs",
        "cwd": "packages/tokens"
      },
      "outputs": [
        "{projectRoot}/src/reference/brands",
        "{projectRoot}/src/generated-brands.ts"
      ],
      "cache": true,
      "inputs": ["{projectRoot}/scripts/generate-palettes.mjs"]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-palettes"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node build.mjs",
        "cwd": "packages/tokens"
      }
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
