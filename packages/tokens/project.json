{
  "name": "tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tokens/src",
  "projectType": "library",
  "tags": ["scope:tokens"],
  "targets": {
    "generate-palettes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/generate-palettes.mjs",
        "cwd": "packages/tokens"
      },
      "outputs": [
        "{projectRoot}/src/reference/brands",
        "{projectRoot}/src/generated-brands.ts"
      ],
      "cache": true,
      "inputs": ["{projectRoot}/scripts/generate-palettes.mjs"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "build-css": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-palettes"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node build.mjs",
        "cwd": "packages/tokens"
      }
    },
    "build-js": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["generate-palettes"],
      "options": {
        "outputPath": "packages/tokens/dist/js",
        "main": "packages/tokens/src/index.ts",
        "tsConfig": "packages/tokens/tsconfig.lib.json",
        "format": ["esm", "cjs"],
        "declarationRootDir": "packages/tokens/src",
        "generatePackageJson": false,
        "thirdParty": false
      }
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build-css", "build-js"]
    }
  }
}
