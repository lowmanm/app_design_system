{
  "name": "tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tokens/src",
  "projectType": "library",
  "tags": ["scope:tokens"],
  "targets": {
    "generate-palettes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/generate-palettes.mjs",
        "cwd": "packages/tokens"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node build.mjs",
        "cwd": "packages/tokens"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/build.mjs"]
    }
  }
}
