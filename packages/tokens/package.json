{
  "name": "@app-design-system/tokens",
  "version": "0.1.0",
  "description": "Design tokens (reference + semantic) - single source of truth, built with Style Dictionary into CSS custom properties, SCSS variables/maps, and JSON.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/js/index.cjs",
  "module": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "import": "./dist/js/index.js",
      "require": "./dist/js/index.cjs"
    },
    "./css/*": "./dist/css/*",
    "./scss/*": "./dist/scss/*",
    "./json/*": "./dist/json/*",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  }
}
