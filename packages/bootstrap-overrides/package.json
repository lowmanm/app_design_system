{
  "name": "@app-design-system/bootstrap-overrides",
  "version": "0.1.0",
  "description": "Bootstrap 5 Sass variable overrides + a runtime CSS-variable bridge, one per business-unit brand, both derived from @app-design-system/tokens.",
  "license": "MIT",
  "exports": {
    "./themes/*": "./src/themes/*.scss",
    "./runtime-theme-bridge.css": "./src/runtime-theme-bridge.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "peerDependencies": {
    "bootstrap": "^5.3.0",
    "sass": "^1.83.0"
  },
  "dependencies": {
    "@app-design-system/tokens": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
