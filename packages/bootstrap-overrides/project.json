{
  "name": "bootstrap-overrides",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/bootstrap-overrides/src",
  "projectType": "library",
  "tags": ["scope:bootstrap"],
  "implicitDependencies": ["tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["tokens:build"],
      "options": {
        "command": "node compile-themes.mjs",
        "cwd": "packages/bootstrap-overrides"
      },
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
