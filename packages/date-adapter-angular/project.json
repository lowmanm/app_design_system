{
  "name": "date-adapter-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/date-adapter-angular/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:angular"],
  "implicitDependencies": ["date-utils"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["date-utils:build"],
      "outputs": ["{workspaceRoot}/dist/packages/date-adapter-angular"],
      "options": {
        "command": "ng-packagr -p ng-package.json -c tsconfig.package.json",
        "cwd": "packages/date-adapter-angular"
      }
    }
  }
}
