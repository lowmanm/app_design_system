{
  "name": "footer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/components/footer/src",
  "prefix": "brk",
  "projectType": "library",
  "tags": ["scope:angular"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/components/footer"],
      "options": {
        "command": "ng-packagr -p ng-package.json -c tsconfig.package.json",
        "cwd": "packages/components/footer"
      }
    }
  }
}
