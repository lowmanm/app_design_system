{
  "name": "card",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/components/card/src",
  "prefix": "brk",
  "projectType": "library",
  "tags": ["scope:angular"],
  "implicitDependencies": ["core"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["core:build"],
      "outputs": ["{workspaceRoot}/dist/packages/components/card"],
      "options": {
        "command": "ng-packagr -p ng-package.json -c tsconfig.package.json",
        "cwd": "packages/components/card"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "^production"]
    }
  }
}
